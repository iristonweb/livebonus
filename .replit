modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "web-smoke"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "mockup-previews"

[[workflows.workflow]]
name = "web-smoke"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/loyalti run test:smoke"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "mockup-previews"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/mockup-sandbox run test:previews"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 23657
externalPort = 3000

[[ports]]
localPort = 23906
externalPort = 3002

[nix]
channel = "stable-25_05"
packages = ["chromium"]

[userenv]

[userenv.production]

[userenv.shared]
YOOKASSA_WEBHOOK_ALLOWED_CIDRS = "185.71.76.0/27,185.71.77.0/27,77.75.153.0/25,77.75.156.11/32,77.75.156.35/32,2a02:5180::/32"
